From: Pan Zapalka <jarek@slopkernel.local>
Subject: [PATCH] configs: nova: Enable Android USB gadget and Samsung charging options

This patch adds the necessary CONFIG flags to nova_defconfig to enable
USB data transmission (MTP/ADB) and proper charger type detection for 
Samsung devices using the SM5714 MUIC/PDIC chip.

--- a/arch/arm64/configs/nova_defconfig
+++ b/arch/arm64/configs/nova_defconfig
@@ -3400,3 +3400,21 @@
 CONFIG_SAMSUNG_CAMERA_OTP=y
 CONFIG_GC5035_MACRO_OTP_DD_AUTOLOAD=y
 # CONFIG_SAMSUNG_HW_SOFTLANDING is not set
+
+# Android USB Gadget & Samsung Composite Support
+CONFIG_USB_GADGET=y
+CONFIG_USB_G_ANDROID=y
+CONFIG_USB_ANDROID_SAMSUNG_COMPOSITE=y
+
+# ConfigFS for MTP and ADB
+CONFIG_USB_CONFIGFS=y
+CONFIG_USB_CONFIGFS_F_MTP=y
+CONFIG_USB_CONFIGFS_F_PTP=y
+CONFIG_USB_CONFIGFS_F_ACC=y
+CONFIG_USB_CONFIGFS_F_AUDIO_SRC=y
+CONFIG_USB_CONFIGFS_F_DIAG=y
+CONFIG_USB_CONFIGFS_F_CDEV=y
+CONFIG_USB_CONFIGFS_F_QDSS=y
+
+# External Connector Support for Charger/PC Detection
+CONFIG_EXTCON=y
+CONFIG_EXTCON_SAMSUNG=y
+CONFIG_POWER_SUPPLY=y
+CONFIG_SAMSUNG_BATTERY=y
+CONFIG_SAMSUNG_RECOVERY_CHARGING=y
